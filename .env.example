# Indodax API credentials
# Create at https://indodax.com/trade_api  -- ENABLE "view" + "trade" ONLY.
# NEVER enable "withdraw". IP-whitelist the key if you have a static IP.
INDODAX_KEY=your_api_key_here
INDODAX_SECRET=your_api_secret_here
# The IP you entered in Indodax's "IP Permission" box. Home broadband is
# dynamic, so  compares this against your live IP and warns
# you before the key silently stops working.
INDODAX_WHITELIST_IP=

# Dashboard token. Leave blank and one is generated (and printed) each start;
# set it to a fixed value so the phone does not need re-pairing after a restart.
DASHBOARD_TOKEN=

# OPTIONAL. Only used by `lumbung news` to judge which headlines are material.
# Without it the news screen falls back to keyword flagging, which still works.
# Nothing else in this project calls a model.
OPENROUTER_API_KEY=

# OPTIONAL. Your own vision model, used only by `lumbung scan` to read receipts.
# Any OpenAI-compatible server: vLLM, Ollama, LM Studio, llama.cpp.
# The model must be vision-capable (a -VL variant); a text-only model cannot
# read an image and will either error or invent one.
# The image never leaves your machine.
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_KEY=

# Environment: paper | live
TA_MODE=paper

# ── OpenCode 2 (GLM): the always-on answerer ────────────────────────────────
# Same pattern as AppWork/claude-code-telegram's AGENT_BACKEND=opencode: one
# `opencode2 serve` on localhost, driven over its local API. Requires opencode2
# on PATH (`opencode2 auth list` should show your Z.AI Coding Plan).
# Every field optional-empty = agent features fully off, unchanged behaviour
# (which is what a second profile on this install relies on).
# OPENCODE_MODEL=zai-coding-plan/glm-5.3   # empty disables everything below
# OPENCODE_PORT=42778                      # the Telegram bot claims 42777
# OPENCODE_BIN=opencode2                   # only if not on PATH
# AGENT_WORKER=1                           # run the chat/research answerer
# AGENT_BRAIN=donchian                     # engine signals: donchian | llm
